# Amni-Prism Integration Test Configuration
# Copy to .env and fill in your keys (never commit .env!)

# Local nano model endpoint
PRISM_NANO_URL=http://127.0.0.1:8788/v1/chat/completions
PRISM_NANO_MODEL=gemma-e2b-ptex

# Large model for verification (set at least one)
XAI_API_KEY=
XAI_MODEL=grok-code-fast-1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4.6
